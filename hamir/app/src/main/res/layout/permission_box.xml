<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/permission_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/panel"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/permission_text"
        style="@style/HamirBody"
        android:text="@string/perm_mic_rationale" />

    <Button
        android:id="@+id/permission_button"
        style="@style/HamirButtonPrimary"
        android:layout_marginTop="8dp"
        android:text="@string/action_grant" />

    <TextView
        android:id="@+id/permission_settings_hint"
        style="@style/HamirNote"
        android:layout_marginTop="8dp"
        android:text="@string/perm_mic_settings_hint"
        android:visibility="gone" />

    <Button
        android:id="@+id/permission_settings_button"
        style="@style/HamirButton"
        android:text="@string/action_open_settings"
        android:visibility="gone" />
</LinearLayout>
